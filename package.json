{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "menubar-notifications",
  "title": "Menubar Notifications",
  "description": "Unified menu bar notifications and local agent status indicators",
  "icon": "command-icon.png",
  "author": "robox",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Communication",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "mail",
      "title": "Mail Notifications",
      "description": "Show unread email count from Apple Mail",
      "mode": "menu-bar",
      "interval": "1m"
    },
    {
      "name": "telegram",
      "title": "Telegram Notifications",
      "description": "Show unread Telegram messages",
      "mode": "menu-bar",
      "interval": "1m",
      "preferences": [
        {
          "name": "apiId",
          "type": "textfield",
          "title": "Telegram API ID",
          "description": "Telegram API ID",
          "required": true,
          "placeholder": "1234567"
        },
        {
          "name": "apiHash",
          "type": "textfield",
          "title": "Telegram API Hash",
          "description": "Telegram API Hash",
          "required": true,
          "placeholder": "abcdefghijklmnopqrstuvwxyz1234567890"
        },
        {
          "name": "sessionKey",
          "type": "textfield",
          "title": "Telegram Session Key",
          "description": "Telegram Session Key",
          "required": true,
          "placeholder": "AbCdEfGhIjKlMnOpQrStUvWxYz12345="
        }
      ]
    },
    {
      "name": "github-prs",
      "title": "GitHub PR Notifications",
      "description": "Show PRs requesting your review",
      "mode": "menu-bar",
      "interval": "1m"
    },
    {
      "name": "jira",
      "title": "Jira in Progress",
      "description": "Notify when no Jira issues are In Progress",
      "mode": "menu-bar",
      "interval": "30m",
      "preferences": [
        {
          "name": "jiraAuth",
          "type": "password",
          "title": "Jira Basic Auth",
          "description": "Base64 of email:api_token",
          "required": true,
          "placeholder": "bWFpbEBleGFtcGxlLmNvbTp0b2tlbg=="
        },
        {
          "name": "jiraBaseUrl",
          "type": "textfield",
          "title": "Jira Base URL",
          "description": "e.g. https://yourcompany.atlassian.net",
          "required": true,
          "placeholder": "https://yourcompany.atlassian.net"
        }
      ]
    },
    {
      "name": "slack",
      "title": "Slack Notifications",
      "description": "Show Slack unread badge count",
      "mode": "menu-bar",
      "interval": "1m"
    },
    {
      "name": "codex-status",
      "title": "Codex Status",
      "description": "Show when Codex is working or needs attention",
      "mode": "menu-bar",
      "interval": "10s"
    },
    {
      "name": "claude-status",
      "title": "Claude Status",
      "description": "Show when the default Claude Desktop profile is working or needs attention",
      "mode": "menu-bar",
      "interval": "10s"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.1.2",
    "@raycast/utils": "^2.3.0",
    "teleproto": "^1.229.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@11.25.0"
}
